{
  "name": "forgecut",
  "private": true,
  "version": "1.0.3",
  "author": {
    "name": "Alex Wanyoike",
    "email": "alex.m.wanyoike@gmail.com"
  },
  "homepage": "https://github.com/alexanderwanyoike/forgecut",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "node electron/scripts/dev.mjs",
    "dev:web": "vite",
    "dev:electron": "yarn dev",
    "build:electron": "tsc -p electron/tsconfig.json && yarn build:graphics && yarn build:mcp && yarn build:code-runtime",
    "build:renderer": "tsc && vite build",
    "build": "yarn build:renderer && yarn build:electron",
    "verify:electron": "node electron/scripts/verify-startup.mjs",
    "package": "yarn build && yarn build:graphic-runtime && electron-builder --publish never",
    "package:linux": "yarn build && yarn build:graphic-runtime && electron-builder --linux --publish never",
    "package:mac": "yarn build && yarn build:graphic-runtime && electron-builder --mac --publish never",
    "package:win": "yarn build && yarn build:graphic-runtime && electron-builder --win --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --ignore-path ../../../.prettierignore --write ../../..",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ../../..",
    "analyze": "fallow",
    "analyze:architecture": "fallow architecture",
    "analyze:health": "fallow health",
    "lint": "eslint src electron --ext .ts,.tsx,.cts",
    "mcp": "node electron/dist/mcp-adapter.cjs",
    "build:mcp": "node electron/scripts/build-mcp.mjs",
    "build:graphics": "node electron/scripts/prepare-graphics.mjs",
    "build:graphic-runtime": "node electron/scripts/prepare-graphic-runtime.mjs",
    "test:graphics": "node electron/scripts/verify-graphics.mjs",
    "build:code-runtime": "node electron/scripts/prepare-code-runtime.mjs",
    "pretest": "yarn build:code-runtime",
    "pretest:watch": "yarn build:code-runtime"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "electron-updater": "6.8.11",
    "image-size": "2.0.4",
    "lucide-react": "0.555.0",
    "proper-lockfile": "4.1.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "semver": "7.7.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "fallow": "3.35.0",
    "jsdom": "^28.1.0",
    "monaco-editor": "0.57.0",
    "prettier": "3.9.10",
    "remotion": "4.0.537",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
