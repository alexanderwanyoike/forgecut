{
  "name": "forgecut-integration-check",
  "version": "0.0.0",
  "description": "Local evaluation fixture for ForgeCut integrations",
  "author": "ForgeCut contributors",
  "repository": "https://github.com/alexanderwanyoike/forgecut",
  "main": "main.mjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node prepare.mjs && vite build",
    "verify:electron": "electron main.mjs",
    "verify:render": "node render.mjs",
    "verify:mcp": "node mcp-check.mjs",
    "verify:phase0": "node verify-phase0.mjs",
    "prepare:runtime": "node prepare-runtime.mjs",
    "package": "electron-builder --dir --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@remotion/bundler": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "electron": "33.4.11",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537",
    "vite": "6.4.1"
  }
}
